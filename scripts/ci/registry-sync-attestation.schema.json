{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Registry sync attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cc0_rights_held",
    "publishing_entity",
    "tos_effective",
    "attested_on",
    "decision_ref",
    "conditions",
    "attested_content_sha256"
  ],
  "properties": {
    "cc0_rights_held": { "const": true },
    "publishing_entity": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
    "tos_effective": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "attested_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "decision_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "attested_content_sha256": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "attested_on"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "attested_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}
