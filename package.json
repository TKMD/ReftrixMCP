{
  "name": "reftrixmcp",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "WebDesign Knowledge Base Platform - Layout Analysis, Motion Detection, and Quality Evaluation with AI",
  "author": "Reftrix Contributors",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/TKMD/ReftrixMCP.git"
  },
  "homepage": "https://github.com/TKMD/ReftrixMCP#readme",
  "bugs": {
    "url": "https://github.com/TKMD/ReftrixMCP/issues"
  },
  "keywords": [
    "webdesign",
    "layout-analysis",
    "motion-detection",
    "quality-evaluation",
    "search",
    "semantic-search",
    "mcp",
    "claude",
    "ai",
    "knowledge-base",
    "react",
    "typescript",
    "pgvector",
    "embedding"
  ],
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "protobufjs"
    ],
    "overrides": {
      "express": ">=5.2.0",
      "zod": ">=4.6.6 <5",
      "qs": ">=6.16.1 <7",
      "ws": ">=8.20.1",
      "undici": ">=7.30.1 <8",
      "uuid": ">=11.1.1",
      "brace-expansion": ">=5.0.12 <6",
      "jsdom": "27.2.0",
      "hono": ">=4.13.11 <5",
      "@hono/node-server": ">=2.0.10 <3",
      "dompurify": ">=3.4.16 <4",
      "tar": ">=7.5.21",
      "tmp": ">=0.2.6",
      "minimatch": ">=10.2.3",
      "@modelcontextprotocol/sdk>ajv": ">=8.18.0",
      "express-rate-limit": ">=8.2.2",
      "flatted": ">=3.4.2",
      "effect": ">=3.20.0",
      "picomatch": ">=4.0.5",
      "yaml": ">=2.8.3",
      "lodash": ">=4.18.0",
      "defu": ">=6.1.5",
      "protobufjs": ">=8.4.1",
      "@grpc/grpc-js": ">=1.14.5 <2",
      "vite": "8.1.6",
      "postcss": ">=8.5.18",
      "ip-address": ">=10.7.4 <11",
      "@cyclonedx/cdxgen>uuid": ">=13.0.1",
      "jsonata": ">=2.2.0",
      "eslint>ajv": ">=6.14.0 <7",
      "@eslint/eslintrc>ajv": ">=6.14.0 <7",
      "fast-uri": ">=3.1.8 <4",
      "sharp": ">=0.35.5 <0.36",
      "deepmerge-ts": ">=8.0.2",
      "browserslist": ">=4.28.7 <5",
      "baseline-browser-mapping": ">=2.11.0 <3",
      "@humanfs/node": ">=0.16.8 <0.17",
      "@babel/core": ">=7.29.6 <8",
      "vitest": ">=4.1.12 <5",
      "@vitest/mocker": ">=4.1.12 <5",
      "@vitest/coverage-v8": ">=4.1.12 <5",
      "body-parser": ">=2.4.0 <3",
      "proxy-addr": ">=2.0.8 <3",
      "compression": ">=1.8.2 <2",
      "source-map-js": ">=1.2.2 <2",
      "handlebars": ">=4.7.10 <5",
      "@modelcontextprotocol/sdk": ">=1.32.1 <1.33"
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:smoke": "turbo run test:smoke",
    "test:regression:standing": "turbo run test:regression:standing",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:generate": "turbo run db:generate --filter=@reftrixmcp/database",
    "db:migrate": "turbo run db:migrate --filter=@reftrixmcp/database",
    "db:seed": "turbo run db:seed --filter=@reftrixmcp/database",
    "db:studio": "turbo run db:studio --filter=@reftrixmcp/database",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:migrate:safe": "bash scripts/db-migrate-safe.sh",
    "sbom": "cdxgen --output sbom.cdx.json --spec-version 1.6",
    "verify:listener-sync": "pnpm --filter @reftrixmcp/mcp-server verify:listener-sync",
    "verify:no-worker-pause": "pnpm --filter @reftrixmcp/mcp-server verify:no-worker-pause",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cyclonedx/cdxgen": ">=12.4.3 <12.8.3",
    "@types/js-yaml": "^4.0.9",
    "husky": "^9.1.0",
    "js-yaml": "^4.3.1",
    "playwright": "^1.57.0",
    "ts-morph": "^27.0.2",
    "turbo": "^2.9.14",
    "vite": "8.1.6"
  }
}
