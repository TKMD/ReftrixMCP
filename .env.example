# Reftrix Environment Variables
# Copy this file to .env.local and fill in your values

# Database (PostgreSQL + pgvector)
# Port offset: 21000 (standard: 5432 -> 26432)
DATABASE_URL="postgresql://reftrix:change_me@localhost:26432/reftrix?schema=public"

# PostgreSQL パスワード（Docker Compose 用、独立変数）
# Docker Compose reads this via env_file. Must match the password in DATABASE_URL above.
POSTGRES_PASSWORD="change_me"

# Redis (for BullMQ async job processing)
# Port offset: 21000 (standard: 6379 -> 27379)
REDIS_URL="redis://localhost:27379"
REDIS_HOST=localhost
REDIS_PORT=27379

# Application
NODE_ENV="development"

# Internal API URL (not used in MCP-only mode)
REFTRIX_API_URL="http://localhost:24000/api/v1"

# Embedding Model
MODEL_CACHE_DIR="./.cache/models"
EMBEDDING_BATCH_SIZE=32

# ONNX Execution Provider: see "ML/Embedding" section below for ONNX_EXECUTION_PROVIDER
# ONNX実行プロバイダ: 下部の「ML/Embedding」セクションを参照

# Security
# Generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-change-in-production"  # Phase 2: Not yet implemented

# === Ollama Vision (optional, for NARRATIVE phase) ===
# Requires Ollama installed: https://ollama.com
OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_HOST is used by worker processes (must match OLLAMA_BASE_URL if non-default port)
OLLAMA_HOST="http://localhost:11434"

# === MCP Authentication (recommended for production) ===
MCP_AUTH_ENABLED="false"
# JSON array of API key objects (required when MCP_AUTH_ENABLED=true)
# Each object: { key, role (VIEWER|USER|ADMIN), userId, expiresAt? (ISO 8601) }
# MCP_API_KEYS='[{"key":"reftrix_your_key_here","role":"ADMIN","userId":"admin-001"},{"key":"reftrix_another_key","role":"USER","userId":"user-001","expiresAt":"2027-01-01T00:00:00Z"}]'

# === BullMQ Admin UI (optional) ===
# Set BULLMQ_UI_ENABLED=true to start Bull Board at http://127.0.0.1:21080/admin/queues
# BULLMQ_UI_ENABLED=false
# BULLMQ_UI_USER=admin
# BULLMQ_UI_PASSWORD=change_me_in_production

# === Worker Configuration (optional tuning) ===
WORKER_MAX_JOBS_BEFORE_RESTART=1
# WORKER_CONCURRENCY=1
# WORKER_MAX_RESTART_ATTEMPTS=10
# WORKER_SHUTDOWN_TIMEOUT_MS=10000
# WORKER_RESTART_DELAY_MS=3000
# ワーカー再起動待機時間（ミリ秒） / Delay before worker restart (ms)

# === Crawling: robots.txt Compliance ===
# When true (default), respects robots.txt Disallow directives before crawling.
# Set to "false" to disable. See PRIVACY_POLICY.md Section 4.3.
REFTRIX_RESPECT_ROBOTS_TXT="true"

# === Rate Limiting (v0.2.0) ===
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_RPM=60

# === Search Cache (v0.2.0) ===
# SEARCH_CACHE_MAX_ENTRIES=500
# SEARCH_CACHE_TTL_MS=300000

# === Embedding ===
# EMBEDDING_IDLE_TIMEOUT_MS=30000

# === DINOv2 ===
# DINOV2_MODEL_PATH=
# DINOV2_RECYCLE_ENABLED=true
# DINOV2_FALLBACK_DISPOSE_ENABLED=true
# WORKER_DINOV2_RECYCLE_THRESHOLD=15
# DINOv2セッションリサイクル閾値（推論回数） / DINOv2 session recycle threshold (inference count)

# === ML/Embedding ===
# MODEL_CACHE_DIR is set above
# ONNX_EXECUTION_PROVIDER="cpu"  # Options: cpu, cuda, rocm
# CUDA requires: ONNXRUNTIME_NODE_INSTALL_CUDA=v12 node node_modules/onnxruntime-node/script/install.js
# CUDAにはプロバイダのダウンロードとLD_LIBRARY_PATHの設定が必要（詳細はドキュメント参照）

# === Phase 5 fork() Process Isolation (v0.3.0) ===
# Isolates ONNX Runtime embedding into child processes to prevent OOM (36-58GB → ~10GB)
# ONNX Runtime embedding推論を子プロセスに分離しOOM防止（36-58GB → ~10GB）
# Note: PHASE5_FORK_ENABLED was removed in v0.4.0 (fork is now the only path)
# PHASE5_TEXT_TIMEOUT_MS=300000
# PHASE5_VISUAL_TIMEOUT_MS=600000
# PHASE5_HEARTBEAT_TIMEOUT_MS=60000
# PHASE5_CHILD_CONNECTION_LIMIT=3
# Child process RSS self-monitoring thresholds (MB) — delta-based (v0.4.0 PR3)
# 子プロセスRSS自己監視閾値（MB）— delta ベース (v0.4.0 PR3)
# warn: ログ警告 / kill: 自己終了
# Linux fork() の Copy-on-Write により子プロセスは親の RSS を継承するため、
# 絶対値ではなく delta (currentRss - initialRss) で判定する。
# v0.3.0 の絶対値環境変数 PHASE5_CHILD_RSS_WARN_MB / PHASE5_CHILD_RSS_KILL_MB は
# v0.4.0 PR3 で削除された（親 RSS 継承による偽陽性 self-kill を根絶するため）。
#
# Linux fork() Copy-on-Write makes the child inherit the parent's RSS, so
# thresholds are evaluated against the delta (currentRss - initialRss), not
# the absolute value. The v0.3.0 absolute-value vars PHASE5_CHILD_RSS_WARN_MB /
# PHASE5_CHILD_RSS_KILL_MB were removed in v0.4.0 PR3 to eliminate false
# positive self-kills caused by inherited parent RSS.
# PHASE5_CHILD_RSS_WARN_DELTA_MB=2048
# PHASE5_CHILD_RSS_KILL_DELTA_MB=3072
#
# Observability flag for RSS heartbeat logging (v0.4.0 PR3 / TPA #2).
# When true, heartbeat lines (absolute RSS + delta RSS) are emitted at
# logger.info level during delta-based monitoring rollout. Default false
# keeps the log at logger.debug (invisible in production).
# 可観測性フラグ (v0.4.0 PR3 / TPA #2)。true の場合、heartbeat ログ
# (絶対値 RSS + delta RSS) を logger.info レベルで出力する。delta ベース
# 監視の運用初期に本番で delta の挙動を監視するために使用する。デフォルトは
# false (logger.debug レベル、本番では不可視)。
# PHASE5_RSS_DEBUG=false

# === Embedding Backfill Queue (v0.4.0 PR4) ===
# Queue-based backfill for Part text / visual embeddings exceeding 100 items per page.
# page.analyze の Phase 5 (Embedding) で 1 ページあたり Part が 100 件を超える場合、
# 最初の 100 件のみ同期処理し、残余を `embedding-backfill` Queue で非同期処理する。
#
# When page.analyze Phase 5 (Embedding) has more than 100 Parts per page, only
# the first 100 are processed synchronously; the remainder is backfilled
# asynchronously via the `embedding-backfill` Queue.
#
# EMBEDDING_BACKFILL_CONCURRENCY=1
# Worker の同時ジョブ処理数（OOM 防御のため 1 推奨） / Worker concurrency (1 recommended for OOM defense)
#
# EMBEDDING_SYNC_PART_LIMIT=100
# page.analyze Phase 5 で同期処理する Part 件数の上限。超過分は embedding-backfill
# Queue で非同期処理される。TPA #1 (v0.4.0 PR4 audit) により env var 化。
# 範囲 10〜1000 で clamp（範囲外はデフォルト 100 にフォールバック）。
# Maximum number of Parts processed synchronously in page.analyze Phase 5.
# Excess items are backfilled asynchronously via the embedding-backfill queue.
# Promoted to env var per TPA #1 (v0.4.0 PR4 audit). Clamped to [10, 1000]
# (values outside the range fall back to default 100).

# === Screenshot Persistence (v0.4.0) ===
# Root directory used by two services that share the same allowlist:
#   (1) visual-regression.service.ts (baseline screenshot file paths — path traversal prevention)
#   (2) screenshot-persistence.service.ts (Phase 5 Queue-based Backfill — persisted fullPage screenshots)
# サブディレクトリ `phase5/` 配下に `<webPageId>.png` 形式で永続化される。
# 2つのサービスが共有する許可ルートディレクトリ:
#   (1) visual-regression.service.ts (ベースラインスクリーンショットパス — パストラバーサル防止)
#   (2) screenshot-persistence.service.ts (Phase 5 Queue-based Backfill 用の永続化スクリーンショット)
# Persisted under the `phase5/` subdirectory as `<webPageId>.png`.
# REFTRIX_SCREENSHOT_ROOT="/tmp/reftrix-screenshots"

# === Section Processing (optional tuning) ===
# BLANK_IMAGE_STDDEV_THRESHOLD=5.0
# MAX_TILES_PER_SECTION=20
# DUPLICATE_VECTOR_THRESHOLD=0.995
# ENABLE_SECTION_SCREENSHOT_FALLBACK=true
# ENABLE_SECTION_MERGE_POSTPROCESSOR=true
# ENABLE_SECTION_SPLIT_POSTPROCESSOR=true
