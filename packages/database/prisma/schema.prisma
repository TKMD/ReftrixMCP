// ============================================================================
// Responsive Analysis Models
// Reference: レスポンシブデザイン分析（マルチビューポート比較、ブレークポイント検出）
// ============================================================================

/// ResponsiveAnalysis - レスポンシブデザイン分析結果
/// 複数ビューポートでの表示差分、ブレークポイント、スクリーンショット比較を保持
model ResponsiveAnalysis {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webPageId String @map("web_page_id") @db.Uuid

  // 分析対象ビューポート（JSONB）
  /// [{name: "desktop", width: 1440, height: 900}, {name: "mobile", width: 375, height: 812}]
  viewportsAnalyzed Json @map("viewports_analyzed")

  // ビューポート間の差異（JSONB）
  /// [{category: "layout", description: "Grid changes from 3 columns to 1", viewports: ["desktop", "mobile"]}]
  differences Json @map("differences")

  // 検出されたブレークポイント（JSONB, nullable）
  /// [{name: "tablet", minWidth: 768}, {name: "desktop", minWidth: 1024}]
  breakpoints Json? @map("breakpoints")

  // スクリーンショット差分（JSONB, nullable）
  /// [{viewport1: "desktop", viewport2: "mobile", diffPercentage: 45.2}]
  screenshotDiffs Json? @map("screenshot_diffs")

  // 品質メトリクス（JSONB, nullable — Phase 2で拡張）
  qualityMetrics Json? @map("quality_metrics")

  // 分析所要時間（ミリ秒）
  analysisTimeMs Int @map("analysis_time_ms")

  // タイムスタンプ
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // リレーション
  webPage WebPage @relation(fields: [webPageId], references: [id], onDelete: Cascade)

  // リレーション: Embedding
  embedding ResponsiveAnalysisEmbedding?

  @@index([webPageId])
  @@map("responsive_analyses")
}

/// ResponsiveAnalysisEmbedding - レスポンシブ分析結果のベクトル埋め込み
/// セマンティック検索用（例: "モバイルでナビゲーションが変化するサイト" "3カラムが1カラムに変わるレイアウト"）
/// HNSW Index: idx_responsive_analysis_embeddings_hnsw (m=16, ef_construction=64, vector_cosine_ops)
/// Performance Target: Vector Search P95 < 100ms
model ResponsiveAnalysisEmbedding {
  id                   String @id @default(dbgenerated("gen_uuidv7()")) @db.Uuid
  responsiveAnalysisId String @unique @map("responsive_analysis_id") @db.Uuid

  // Embedding (768D, multilingual-e5-base)
  // HNSW indexed for semantic search
  embedding Unsupported("vector(768)")? @map("embedding")

  // テキスト表現（Embedding生成元）
  // 例: "Responsive analysis: https://example.com\nViewports: desktop(1920x1080), tablet(768x1024), mobile(375x667)\nDifferences:\n- [layout] .grid: グリッドカラム数が4列から2列に変化"
  textRepresentation String? @map("text_representation") @db.Text

  // 全文検索用tsvectorカラム（GENERATED ALWAYS AS）
  // PostgreSQL側でtext_representationから自動生成、GINインデックス付き
  searchVector Unsupported("tsvector")? @map("search_vector")

  // メタデータ
  modelVersion       String   @map("model_version") // 'multilingual-e5-base'
  embeddingTimestamp DateTime @default(now()) @map("embedding_timestamp") @db.Timestamptz

  // タイムスタンプ
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // リレーション
  responsiveAnalysis ResponsiveAnalysis @relation(fields: [responsiveAnalysisId], references: [id], onDelete: Cascade)

  @@map("responsive_analysis_embeddings")
}

// ============================================================================
// Preference Profiling Models
// ユーザー嗜好プロファイリング（preference.hear / preference.get / preference.reset）
// User Preference Profiling (preference.hear / preference.get / preference.reset)
// ============================================================================

/// PreferenceProfile - ユーザー嗜好プロファイル
/// デザイン嗜好をベクトル空間で表現し、セマンティック検索で類似デザインを推薦
/// User preference profile: represents design preferences in vector space
/// for semantic search-based design recommendations
/// HNSW Index: idx_preference_profiles_embedding_hnsw (m=16, ef_construction=64, vector_cosine_ops)
model PreferenceProfile {
  id   String @id @default(dbgenerated("gen_uuidv7()")) @db.Uuid
  name String @default("default") @db.VarChar(100)

  // 嗜好ベクトル（768D, multilingual-e5-base）
  // Preference embedding (768D, multilingual-e5-base)
  // HNSW indexed for semantic similarity search
  preferenceEmbedding Unsupported("vector(768)")? @map("preference_embedding")

  // 嗜好テキスト（Embedding生成元）
  // Preference text (source for embedding generation)
  // 例: "ミニマルでダークなデザイン、大胆なタイポグラフィ、滑らかなアニメーション"
  preferenceText String? @map("preference_text") @db.Text

  // インタラクション回数（嗜好シグナルの累積数）
  // Interaction count (cumulative number of preference signals)
  interactionCount Int @default(0) @map("interaction_count")

  // メタデータ（JSONB）
  // Metadata (JSONB)
  // 例: { "lastHearAt": "2026-03-07T...", "dominantMoods": ["minimalist", "bold"] }
  metadata Json @default("{}") @map("metadata")

  // タイムスタンプ / Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // リレーション / Relations
  signals PreferenceSignal[]

  @@map("preference_profiles")
}

/// PreferenceSignal - 嗜好シグナル（個別のフィードバック記録）
/// preference.hear で記録される個別のデザイン評価・反応
/// Individual feedback records captured by preference.hear
/// signal_type: hearing_positive / hearing_negative / hearing_neutral / code_generate / search_click
/// target_type: web_page / section_pattern / motion_pattern / background_design
model PreferenceSignal {
  id        String @id @default(dbgenerated("gen_uuidv7()")) @db.Uuid
  profileId String @map("profile_id") @db.Uuid

  // シグナル情報 / Signal info
  signalType   String @map("signal_type") @db.VarChar(50) // hearing_positive / hearing_negative / hearing_neutral / code_generate / search_click
  signalWeight Float  @map("signal_weight") @db.DoublePrecision // シグナルの重み（正: 好意、負: 嫌悪） / Signal weight (positive: like, negative: dislike)

  // 対象情報（ポリモーフィック参照） / Target info (polymorphic reference)
  targetType String @map("target_type") @db.VarChar(50) // web_page / section_pattern / motion_pattern / background_design
  targetId   String @map("target_id") @db.Uuid

  // フィードバックテキスト（LLM要約後、原文ではない）
  // Feedback text (LLM-summarized, not raw input)
  // 例: "ヒーローセクションのグラデーション背景と大きなタイポグラフィを高評価"
  feedbackText String? @map("feedback_text") @db.Text

  // シグナルベクトル（768D, multilingual-e5-base）
  // Signal embedding (768D, multilingual-e5-base)
  embedding Unsupported("vector(768)")? @map("embedding")

  // タイムスタンプ / Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // リレーション / Relations
  profile PreferenceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([signalType])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
  @@map("preference_signals")
}

// ============================================================================
// Part-Level Analysis Models
// Reference: part-level-analysis.md v0.2.1
// ============================================================================

/// ComponentPart - セクション内の構成パーツ（ボタン、カード、ナビゲーション等）
/// Part-level granularity for design component analysis
/// partType: 'button' | 'card' | 'navigation' | 'form' | 'hero-image' | etc.
model ComponentPart {
  id               String   @id @default(dbgenerated("gen_uuidv7()")) @db.Uuid
  webPageId        String   @map("web_page_id") @db.Uuid
  sectionPatternId String   @map("section_pattern_id") @db.Uuid
  partType         String   @map("part_type") @db.VarChar(50)
  partSubtype      String?  @map("part_subtype") @db.VarChar(100)
  htmlSnippet      String?  @map("html_snippet")
  computedStyles   Json     @default("{}") @map("computed_styles")
  boundingBox      Json     @default("{}") @map("bounding_box")
  cssClasses       String[] @default([]) @map("css_classes")
  attributes       Json     @default("{}") @map("attributes")
  interactionInfo  Json     @default("{}") @map("interaction_info")
  visualSignature  String?  @map("visual_signature") @db.VarChar(64)
  sampleIndex      Int      @default(0) @map("sample_index")
  piiRiskLevel     String   @default("none") @map("pii_risk_level") @db.VarChar(10)
  tags             String[] @default([])
  metadata         Json     @default("{}")
  sourceUrl        String?  @map("source_url")
  usageScope       String   @default("inspiration_only") @map("usage_scope") @db.VarChar(20)
  extractedAt      DateTime @map("extracted_at") @db.Timestamptz()
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // リレーション / Relations
  webPage        WebPage                 @relation(fields: [webPageId], references: [id], onDelete: Cascade)
  sectionPattern SectionPattern          @relation(fields: [sectionPatternId], references: [id], onDelete: Cascade)
  embedding      ComponentPartEmbedding?

  @@unique([sectionPatternId, visualSignature])
  @@index([webPageId])
  @@index([sectionPatternId])
  @@index([partType])
  @@index([webPageId, partType])
  @@index([piiRiskLevel])
  @@map("component_parts")
}

/// ComponentPartEmbedding - コンポーネントパーツのベクトル埋め込み
/// HNSW Indexes (m=16, ef_construction=64, vector_cosine_ops):
///   - idx_component_part_embeddings_visual_hnsw
///   - idx_component_part_embeddings_text_hnsw
/// GIN Index: idx_component_part_embeddings_search_vector
/// Performance Target: Vector Search P95 < 100ms
model ComponentPartEmbedding {
  id                 String                      @id @default(dbgenerated("gen_uuidv7()")) @db.Uuid
  componentPartId    String                      @unique @map("component_part_id") @db.Uuid
  visualEmbedding    Unsupported("vector(768)")? @map("visual_embedding")
  textEmbedding      Unsupported("vector(768)")? @map("text_embedding")
  textRepresentation String?                     @map("text_representation")
  searchVector       Unsupported("tsvector")?    @map("search_vector")
  // ADR-0018 Amendment 7 §7.1 (Plan v2 PR-B, UB-9): terminal-skip per-row marker.
  // Non-NULL value (one of EMBEDDING_PART_VISUAL_SKIP_REASONS: bbox_invalid /
  // bbox_unresolvable) excludes the row from the part_visual pending query so the
  // backfill processor stops re-fetching it (NF-TPA-01 infinite re-fetch closure).
  // CHECK constraint enforced at the SQL layer (see migration); kept TEXT-typed
  // here per the existing skipReason TEXT convention. Non-PII (GDPR Recital 26 /
  // Art.4(1)); CASCADE-deleted with parent, no independent retention (ADR §7.5 req5).
  visualSkipReason   String?                     @map("visual_skip_reason")
  visualModelVersion String                      @map("visual_model_version") @db.VarChar(50)
  textModelVersion   String                      @map("text_model_version") @db.VarChar(50)
  embeddingTimestamp DateTime                    @map("embedding_timestamp") @db.Timestamptz()
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz()

  // リレーション / Relations
  componentPart ComponentPart @relation(fields: [componentPartId], references: [id], onDelete: Cascade)

  @@index([componentPartId])
  @@map("component_part_embeddings")
}

// ============================================================================
// Audit Log Model (v0.3.0)
// GDPR Art.30 "Records of processing activities" + CWE-778 "Insufficient logging"
// Append-only design: UPDATE/DELETE restricted (cleanup only exception)
// ============================================================================

/// AuditLog - 監査ログ（GDPR Art.30 処理活動記録）
/// Append-only設計: 通常のUPDATE/DELETE不可（cleanupのみ例外）
/// PII配慮: targetIdはtruncateId()で切り詰め保存
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp  DateTime @default(now()) @db.Timestamptz
  action     String   @db.VarChar(100) // e.g., "data.delete", "page.analyze", "preference.reset"
  actor      String   @db.VarChar(100) // e.g., "mcp-client", "system", "worker"
  targetType String   @map("target_type") @db.VarChar(100) // e.g., "web_page", "preference_profile"
  targetId   String?  @map("target_id") @db.VarChar(50) // Truncated UUID (PII consideration)
  details    Json? // Additional context (sanitized, no secrets)
  ipAddress  String?  @map("ip_address") @db.VarChar(45) // IPv4/IPv6
  result     String   @db.VarChar(20) // "success" | "failure" | "denied"

  @@index([action])
  @@index([timestamp])
  @@index([targetType, targetId], map: "idx_audit_logs_target")
  @@map("audit_logs")
}

// ============================================================================
// Search Log Models (v0.3.0 T2-FAC)
// 検索ログ記録・分析（ファセット検索 + MLフィードバックループ基盤）
// Search log recording & analysis (facet search + ML feedback loop foundation)
// ============================================================================

/// SearchLog - 検索ログ（検索クエリ・パフォーマンス・結果の記録）
/// Append-only設計: 通常のUPDATE/DELETE不可
/// PII配慮: queryは200文字truncate、profileIdはtruncateId()
model SearchLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp   DateTime @default(now()) @db.Timestamptz
  query       String   @db.VarChar(200) // 検索クエリ（truncated to 200 chars）
  queryType   String?  @map("query_type") @db.VarChar(50) // visual/structural/functional/stylistic
  services    String[] // 使用された検索サービス / Search services used
  resultCount Int      @default(0) @map("result_count")
  topResultId String?  @map("top_result_id") @db.VarChar(50) // truncated UUID
  filters     Json? // 適用されたフィルタ / Applied filters (sanitized)
  latencyMs   Int?     @map("latency_ms") // 検索レイテンシ（ms）
  cacheHit    Boolean  @default(false) @map("cache_hit")
  profileId   String?  @map("profile_id") @db.VarChar(50) // truncateId() applied (PII consideration)

  @@index([timestamp])
  @@index([queryType], map: "idx_search_logs_query_type")
  @@index([cacheHit], map: "idx_search_logs_cache_hit")
  @@map("search_logs")
}

// ============================================================================
// Design Change Tracking Models (v0.3.0 T2-DCT)
// デザイン変更時系列追跡（スナップショット + Embedding diff）
// Design change temporal tracking (snapshot + embedding diff)
// ============================================================================

/// DesignSnapshot - 特定時点のWebページデザイン状態を記録するスナップショット
/// Captures a point-in-time design state of a web page for temporal comparison
model DesignSnapshot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webPageId    String   @map("web_page_id") @db.Uuid
  snapshotAt   DateTime @default(now()) @map("snapshot_at") @db.Timestamptz
  sectionCount Int      @map("section_count")
  overallScore Float?   @map("overall_score") // quality score at snapshot time
  metadata     Json? // 追加メタデータ（analysisVersion, phaseStatus等）

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // リレーション / Relations
  webPage  WebPage                 @relation(fields: [webPageId], references: [id], onDelete: Cascade)
  sections DesignSnapshotSection[]

  @@index([webPageId, snapshotAt(sort: Desc)])
  @@map("design_snapshots")
}

/// DesignSnapshotSection - スナップショット内の個別セクションデータ（Embedding含む）
/// Individual section data within a snapshot (including embeddings)
model DesignSnapshotSection {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshotId      String                      @map("snapshot_id") @db.Uuid
  sectionType     String                      @map("section_type")
  sectionName     String?                     @map("section_name")
  positionIndex   Int                         @map("position_index")
  textEmbedding   Unsupported("vector(768)")? @map("text_embedding")
  visionEmbedding Unsupported("vector(768)")? @map("vision_embedding")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // リレーション / Relations
  snapshot DesignSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@map("design_snapshot_sections")
}

/// WorkerJobLifecycle - Plan v3 Track T4 (PR-V3-T4) NEW table.
/// Worker spawn / release / restart / dispose イベントを観測する supplementary
/// observability table。Supervisor backfill の orphan 識別 join key を提供し、
/// Linux PID reuse 偽陽性を `worker_pid + worker_spawn_time` 同時等値 join で
/// 構造的に排除する (INV-WORKER-PID-IDENTITY-005 Sub-C cross-PID-reuse defense)。
///
/// WorkerJobLifecycle - Plan v3 Track T4 (PR-V3-T4) NEW table. Records
/// Worker spawn / release / restart / dispose events. Provides the join key
/// for supervisor backfill orphan identification, structurally rejecting
/// Linux PID-reuse false positives via `worker_pid + worker_spawn_time`
/// equality join (INV-WORKER-PID-IDENTITY-005 Sub-C).
///
/// **SEC H-02 / Conflict 4**: excluded from `data.export` allowlist
/// (operational lifecycle data, not personal data per LCC M-01); GDPR Art.17
/// `data.delete` cascades via `onDelete: Cascade` (INV-DATA-DELETE-002).
///
/// **Retention** (LCC H-01): 30 days. Cleanup cron
/// (`apps/mcp-server/scripts/cleanup-orphaned-web-pages.ts`) deletes rows
/// where `event_at < now() - INTERVAL '30 days'` AND paired `web_pages` row
/// already terminally classified.
model WorkerJobLifecycle {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webPageId       String               @map("web_page_id") @db.Uuid
  workerPid       Int                  @map("worker_pid")
  workerSpawnTime DateTime             @map("worker_spawn_time") @db.Timestamptz
  workerType      WorkerType           @map("worker_type")
  eventType       WorkerLifecycleEvent @map("event_type")
  eventAt         DateTime             @default(now()) @map("event_at") @db.Timestamptz
  /// Observability link to ADR-0011 lock nonce (lock semantic stays
  /// nonce-based; PID identity is supplementary observability only).
  nonce           String               @db.Uuid

  // リレーション / Relations
  webPage WebPage @relation(fields: [webPageId], references: [id], onDelete: Cascade)

  @@index([webPageId])
  @@index([workerPid, workerSpawnTime]) // supervisor backfill Sub-C join optimisation
  @@index([eventAt]) // cleanup cron retention scan optimisation
  @@map("worker_job_lifecycle")
}
