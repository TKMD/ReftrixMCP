// ============================================================================
// MCP Creative Tools - Brand Palette Models
// Reference: MCP Creative Tools Phase 1 (style.get_palette, style.apply)
// ============================================================================

/// パレットモード（ライト/ダーク/システム）
enum PaletteMode {
  light
  dark
  system
}

/// カラートークンのロール（役割）
enum ColorRole {
  primary
  secondary
  accent
  neutral
  semantic
}

/// ブランドパレット - ブランドカラーセットを管理
/// MCPツール: style.get_palette, style.apply で使用
model BrandPalette {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @db.VarChar(200)
  slug        String      @unique @db.VarChar(100)
  description String?     @db.Text
  mode        PaletteMode @default(light)
  isDefault   Boolean     @default(false) @map("is_default")

  // Relations
  tokens ColorToken[]

  // WebDesign WebUI Relations
  projectBrandSettings ProjectBrandSetting[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([mode])
  @@index([isDefault])
  @@map("brand_palettes")
}

/// カラートークン - パレット内の個別カラー定義
/// OKLCHカラースペースでの色値を保持（モダンCSS対応）
model ColorToken {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paletteId       String    @map("palette_id") @db.Uuid
  name            String    @db.VarChar(100)
  hex             String    @db.VarChar(7) // #RRGGBB format
  oklchL          Float     @map("oklch_l") // Lightness: 0-1
  oklchC          Float     @map("oklch_c") // Chroma: 0-0.4
  oklchH          Float     @map("oklch_h") // Hue: 0-360
  role            ColorRole
  semanticMeaning String?   @map("semantic_meaning") @db.VarChar(200)
  sortOrder       Int       @default(0) @map("sort_order")

  // Relations
  palette BrandPalette @relation(fields: [paletteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([paletteId, name])
  @@index([paletteId])
  @@index([role])
  @@map("color_tokens")
}

// ============================================================================
// Webdesign Analysis Models
// Reference: docs/plans/webdesign/07-database-schema.md
// ============================================================================

/// 段階的分析ステータス（Phase2-2: 部分結果即時DB保存）
/// 各フェーズ完了時にステータスを更新し、タイムアウト時も部分結果を保持
enum AnalysisPhaseStatus {
  pending // 未開始
  layout_done // Layoutフェーズ完了
  motion_done // Layout + Motionフェーズ完了
  quality_done // 全フェーズ完了（completedと同義）
  completed // 完全完了（quality_doneのエイリアス）
  failed // 失敗（エラー発生）
}

/// Phase 5 embedding の backfill 状態を追跡（v0.4.0 PR2）
/// Tracks the backfill state of Phase 5 embeddings per web_page (v0.4.0 PR2).
///
/// - `not_required`: すべての embedding が同期生成済み（通常パス）
///   All embeddings were generated inline (normal happy path).
/// - `queued` / `in_progress` / `completed`: Backfill Queue ライフサイクル
///   （PR4 で使用） / Backfill queue lifecycle (used by PR4).
/// - `failed`: Backfill が明確に失敗した / Backfill explicitly failed.
/// - `skipped_memory_pressure`: V8 ヒープ/システムメモリ不足で Phase 5 をスキップ
///   Phase 5 skipped due to V8 heap / system memory pressure.
/// - `skipped_fork_error`: fork child プロセスのエラーで Phase 5 をスキップ
///   Phase 5 skipped due to a fork child process error.
/// - `skipped_screenshot_missing`: 永続化された screenshot が repair 時点で不在
///   （PR7b-c 期間の retention-over-deletion bug で欠落した行の修復用、v0.4.0 PR7d-1）
///   Persisted screenshot absent at repair time (repairs PR7b-c retention bug, v0.4.0 PR7d-1).
enum EmbeddingBackfillStatus {
  not_required
  queued
  in_progress
  completed
  failed
  skipped_memory_pressure
  skipped_fork_error
  skipped_screenshot_missing
  failed_with_known_reason
}

/// FailedKnownReason - Plan v3 Track T4 (PR-V3-T4) 終端失敗分類列挙
/// Worker Pre-Return Pause failure-path race closure 用 canonical 内部 enum。
/// Naming convention (TPA L-01 IO Decision): `_2_5` underscore form (NOT
/// `_2.5` dot form — Postgres enum literals 不可)。
///
/// FailedKnownReason - Plan v3 Track T4 (PR-V3-T4) terminal failure
/// classification enum. Canonical internal enum for the Worker Pre-Return
/// Pause failure-path race closure. Naming: `_2_5` underscore form.
///
/// SEC H-01: client-facing surfaces MUST sanitise via
/// `sanitizeAnalysisErrorForClient()` to `analysis_pipeline_interrupted`.
enum FailedKnownReason {
  worker_restart_during_inflight_phase_0
  worker_restart_during_inflight_phase_1
  worker_restart_during_inflight_phase_2_5
  worker_restart_during_inflight_phase_4
  worker_restart_during_inflight_phase_5
  worker_restart_during_inflight_phase_7_5
}

/// WorkerType - Plan v3 Track T4 worker_job_lifecycle table 用 enum
/// (`worker-type` TS SSOT mirror; `page` / `embedding-backfill`)。
///
/// WorkerType - mirror of `apps/mcp-server/src/types/worker-type.ts` SSOT
/// for the worker_job_lifecycle table.
enum WorkerType {
  page
  embedding_backfill @map("embedding-backfill")
}

/// WorkerLifecycleEvent - Plan v3 Track T4 lifecycle event taxonomy.
/// Spawn / release / restart / dispose_start / dispose_end (5 値)。
///
/// WorkerLifecycleEvent - lifecycle event enum (5 values: spawn / release /
/// restart / dispose_start / dispose_end).
enum WorkerLifecycleEvent {
  spawn
  release
  restart
  dispose_start
  dispose_end
}

/// WebPage - 解析対象のWebページ基本情報
/// sourceType: 'award_gallery' | 'user_provided'
/// usageScope: 'inspiration_only' | 'owned_asset' | 'commercial_reuse_allowed'
/// analysisStatus: 'pending' | 'processing' | 'completed' | 'failed'（後方互換性維持）
/// analysisPhaseStatus: AnalysisPhaseStatus（段階的分析用）
model WebPage {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String? @map("project_id") @db.Uuid // Optional: WebPages created before this migration
  url         String  @unique
  title       String?
  description String? @db.Text

  // ソース情報
  sourceType     String  @map("source_type") // 'award_gallery' | 'user_provided'
  sourcePlatform String? @map("source_platform") // 'cssda' | 'fwa' | 'awwwards' | 'custom'
  awardInfo      Json?   @map("award_info")

  // 利用範囲
  usageScope  String  @map("usage_scope") // 'inspiration_only' | 'owned_asset' | 'commercial_reuse_allowed'
  licenseNote String? @map("license_note") @db.Text

  // コンテンツ
  htmlContent String? @map("html_content") @db.Text // 圧縮HTML
  htmlHash    String? @map("html_hash") @db.VarChar(64) // 変更検知用ハッシュ

  // スクリーンショット
  screenshotDesktopUrl String? @map("screenshot_desktop_url") @db.Text
  screenshotMobileUrl  String? @map("screenshot_mobile_url") @db.Text
  screenshotFullUrl    String? @map("screenshot_full_url") @db.Text

  // スクリーンショット永続化パス（Phase 5 Queue-based Backfill 用 / v0.4.0）
  // Screenshot persistence path (for Phase 5 Queue-based Backfill / v0.4.0)
  // ScreenshotPersistenceService.saveScreenshot() が設定、cleanupExpired() で NULL 化
  // Set by ScreenshotPersistenceService.saveScreenshot(), nulled by cleanupExpired()
  screenshotStoragePath String? @map("screenshot_storage_path") @db.Text

  // Embedding backfill 状態（v0.4.0 PR2: サイレント skip 観測性）
  // Embedding backfill status (v0.4.0 PR2: silent-skip observability)
  // Phase 5 が skip/失敗した際に非 'not_required' に更新される
  // Updated to non-'not_required' when Phase 5 is skipped or fails
  embeddingBackfillStatus EmbeddingBackfillStatus @default(not_required) @map("embedding_backfill_status")

  // Embedding backfill 開始時刻（v0.4.0 PR6: stale 判定用専用列）
  // Embedding backfill start timestamp (v0.4.0 PR6: dedicated stale-detection column)
  //
  // backfill status を 'queued' / 'in_progress' に遷移させた時刻を保持する。
  // backfill-reconciliation.service.ts の stale 判定が本列を用いるため、
  // 他カラム更新による updatedAt の揺らぎから影響を受けない。
  //
  // Holds the timestamp when backfill status transitioned to 'queued' / 'in_progress'.
  // Used by backfill-reconciliation.service.ts stale detection, making it immune to
  // updatedAt fluctuations caused by unrelated column updates.
  embeddingBackfillStartedAt DateTime? @map("embedding_backfill_started_at") @db.Timestamptz

  // Embedding backfill 再投入回数（v0.4.0 PR7a: 無限ループ防御）
  // Embedding backfill retry count (v0.4.0 PR7a: infinite-loop defense)
  //
  // skipped_fork_error / skipped_memory_pressure から Queue へ再投入するたびに
  // インクリメントする。5 回超過で embedding_backfill_status を 'failed' に固定し、
  // 永続的なメモリ不足 / fork 障害による無限再投入ループを防止する（SEC HIGH-1）。
  //
  // Incremented each time a page is re-enqueued from skipped_fork_error /
  // skipped_memory_pressure. When the count exceeds 5, embedding_backfill_status
  // is pinned to 'failed' to prevent infinite re-enqueue loops caused by
  // persistent memory pressure / fork failures (SEC HIGH-1).
  embeddingBackfillRetryCount Int @default(0) @map("embedding_backfill_retry_count")

  // Embedding backfill skipped 遷移時刻（v0.4.0 PR7a: skipped_* stale 判定用）
  // Embedding backfill skipped transition timestamp (v0.4.0 PR7a: skipped_* stale detection)
  //
  // status が skipped_fork_error / skipped_memory_pressure に遷移した時刻。
  // cron による skip recovery は本列で経過時間を判定し、recovery 対象を特定する。
  // embeddingBackfillStartedAt とは役割が分離されている（TPA H-1）:
  //   - startedAt: queued / in_progress の stale 判定
  //   - skippedAt: skipped_* からの recovery スケジューリング
  //
  // Timestamp when status transitioned to skipped_fork_error / skipped_memory_pressure.
  // The cron-based skip recovery uses this column to compute elapsed time and identify
  // recovery targets. Role-separated from embeddingBackfillStartedAt (TPA H-1):
  //   - startedAt: stale detection for queued / in_progress
  //   - skippedAt: recovery scheduling from skipped_*
  embeddingBackfillSkippedAt DateTime? @map("embedding_backfill_skipped_at") @db.Timestamptz

  // Embedding backfill 既知失敗理由（Plan v3 T3-Backfill V1 axis B / v0.4.0 Wave 2）
  // Embedding backfill known-failure reason (Plan v3 T3-Backfill V1 axis B / v0.4.0 Wave 2)
  //
  // failed_with_known_reason status と pair で使用される、人間可読 / machine-parseable な
  // 失敗理由のスナップショット (例: "fork_failed", "screenshot_missing_after_retry")。
  // recovery scheduler が部分インデックス (WHERE NOT NULL) で recovery 候補をスキャンする。
  //
  // Snapshot of human-readable / machine-parseable failure reason, paired with
  // failed_with_known_reason status. The recovery scheduler scans recovery candidates
  // via a partial index (WHERE NOT NULL).
  embeddingBackfillFailureReason String? @map("embedding_backfill_failure_reason") @db.Text

  // Embedding backfill 失敗確定時刻（Plan v3 T3-Backfill V1 axis B / v0.4.0 Wave 2）
  // Embedding backfill failure-finalized timestamp (Plan v3 T3-Backfill V1 axis B / v0.4.0 Wave 2)
  //
  // status を failed_with_known_reason に遷移させた時刻。recovery scheduler の
  // 経過時間判定および GDPR Art.30 audit 用に保持。
  //
  // Timestamp when status transitioned to failed_with_known_reason. Retained for the
  // recovery scheduler's elapsed-time computation and GDPR Art.30 audit trail.
  embeddingBackfillFailedAt DateTime? @map("embedding_backfill_failed_at") @db.Timestamptz

  // Screenshot 削除繰延時刻（Plan v3 T3-Backfill V1 axis F / v0.4.0 Wave 2）
  // Screenshot deletion deferral timestamp (Plan v3 T3-Backfill V1 axis F / v0.4.0 Wave 2)
  //
  // failed_with_known_reason へ遷移した際、screenshot 7d TTL 削除を single-deferral cap で
  // 一度だけ繰延する (recovery 試行 window 確保)。cleanup cron が部分インデックスで
  // 繰延対象をスキャンする。NULL = 繰延履歴なし (通常 path)。
  //
  // Defers the screenshot 7d TTL deletion exactly once (single-deferral cap) when
  // transitioning to failed_with_known_reason, ensuring a recovery attempt window.
  // The cleanup cron scans deferral targets via a partial index. NULL = no deferral
  // history (normal path).
  screenshotDeletionDeferredAt DateTime? @map("screenshot_deletion_deferred_at") @db.Timestamptz

  // 解析ステータス（後方互換性維持）
  analysisStatus  String    @default("pending") @map("analysis_status") // 'pending' | 'processing' | 'completed' | 'failed'
  analyzedAt      DateTime? @map("analyzed_at") @db.Timestamptz
  analysisVersion String?   @map("analysis_version") // 解析アルゴリズムバージョン

  // 段階的分析ステータス（Phase2-2: 部分結果即時DB保存）
  // 各フェーズ完了時にステータスを更新し、タイムアウト時も部分結果を保持
  analysisPhaseStatus AnalysisPhaseStatus @default(pending) @map("analysis_phase_status")
  lastAnalyzedPhase   String?             @map("last_analyzed_phase") // 最後に完了したフェーズ: 'layout' | 'motion' | 'quality'
  analysisError       String?             @map("analysis_error") @db.Text // エラーメッセージ
  analysisStartedAt   DateTime?           @map("analysis_started_at") @db.Timestamptz // 分析開始時刻
  analysisCompletedAt DateTime?           @map("analysis_completed_at") @db.Timestamptz // 分析完了時刻

  // Plan v3 Track T4 (PR-V3-T4) — Worker Pre-Return Pause failure-path race
  // closure. NULL until terminally classified; populated via either
  // `markFailedAndAuditAtomic` (child-emit) or
  // `WorkerSupervisorFailurePathService.backfillOrphanWebPageRow`
  // (true orphan: SIGKILL / OOM / segfault).
  failedWithKnownReason FailedKnownReason? @map("failed_with_known_reason")

  // メタデータ
  metadata Json @default("{}")

  // Pre-flight Probe結果（ページ複雑度メトリクス）
  // layout.ingest/page.analyze実行前の軽量プローブで取得
  // タイムアウト値の動的計算に使用
  complexityMetrics Json? @map("complexity_metrics")
  /**
   * {
   * "responseTimeMs": number,         // HEAD/初期レスポンス時間
   * "htmlSizeBytes": number,          // HTMLサイズ
   * "scriptCount": number,            // <script>タグ数
   * "externalResourceCount": number,  // 外部リソース数
   * "hasWebGL": boolean,              // WebGL使用検出
   * "hasSPA": boolean,                // SPA検出（React/Vue/Angular等）
   * "hasHeavyFramework": boolean,     // Three.js等の重いフレームワーク
   * "calculatedTimeoutMs": number,    // 計算されたタイムアウト値
   * "complexityScore": number,        // 複雑度スコア (0-100)
   * "probedAt": string,               // ISO 8601
   * "probeVersion": string            // "0.1.0"
   * }
   */

  // タイムスタンプ
  crawledAt DateTime @default(now()) @map("crawled_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // リレーション
  project                Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectionPatterns        SectionPattern[]
  motionPatterns         MotionPattern[]
  jsAnimationPatterns    JSAnimationPattern[]
  webglAnimationPatterns WebGLAnimationPattern[]
  motionAnalysisResults  MotionAnalysisResult[]
  qualityBenchmarks      QualityBenchmark[]
  designNarrative        DesignNarrative? // 1:1 relationship
  backgroundDesigns      BackgroundDesign[]
  responsiveAnalyses     ResponsiveAnalysis[]
  componentParts         ComponentPart[]
  designSnapshots        DesignSnapshot[]
  workerJobLifecycles    WorkerJobLifecycle[]

  @@index([projectId])
  @@index([projectId, analysisStatus])
  @@index([sourceType])
  @@index([sourcePlatform])
  @@index([analysisStatus])
  @@index([analysisPhaseStatus])
  @@index([projectId, analysisPhaseStatus])
  @@index([crawledAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("web_pages")
}

/// SectionPattern - セクションパターン（ヒーロー、フィーチャー、CTA等）
/// sectionType: 'hero' | 'features' | 'cta' | 'testimonial' | 'pricing' | 'footer' | etc.
model SectionPattern {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webPageId     String  @map("web_page_id") @db.Uuid
  sectionType   String  @map("section_type")
  sectionName   String? @map("section_name")
  positionIndex Int     @map("position_index") // ページ内の順序

  // レイアウト情報（JSON構造体）
  layoutInfo Json @map("layout_info")
  /**
   * {
   * "type": "hero",
   * "grid": { "columns": 2, "gap": "32px" },
   * "alignment": "left",
   * "content_blocks": [...],
   * "responsive": {...}
   * }
   */

  // コンポーネント情報
  components Json @default("[]")
  /**
   * [
   * { "type": "heading", "level": 1, "text": "..." },
   * { "type": "button", "variant": "primary", "text": "..." }
   * ]
   */

  // 視覚特徴
  visualFeatures Json @default("{}") @map("visual_features")
  /**
   * {
   * "color_scheme": { "dominant": "#...", "accent": "#..." },
   * "density": 0.65,
   * "whitespace_ratio": 0.35,
   * "image_ratio": 0.4
   * }
   */

  // HTML/CSS（参照用）
  htmlSnippet String? @map("html_snippet") @db.Text
  cssSnippet  String? @map("css_snippet") @db.Text

  // 外部CSSコンテンツ（motion.detect/layout.ingestで取得した外部CSSファイルの実コンテンツ）
  // cssSnippetはページ内CSS（インライン、<style>タグ、@import参照）を保持
  // externalCssContentは外部ファイル（<link rel="stylesheet">）の実際の内容を保持
  externalCssContent String? @map("external_css_content") @db.Text
  externalCssMeta    Json?   @map("external_css_meta")
  /**
   * {
   * "fetchedCount": 3,
   * "failedCount": 1,
   * "totalSize": 245678,
   * "urls": [
   * { "url": "https://cdn.example.com/styles.css", "size": 120000, "success": true },
   * { "url": "https://cdn.example.com/theme.css", "size": 125678, "success": true }
   * ],
   * "fetchedAt": "2026-01-05T10:30:00Z"
   * }
   */

  // CSSフレームワーク検出結果
  // 値: tailwind, bootstrap, css_modules, styled_components, vanilla, unknown
  cssFramework     String? @map("css_framework") @db.VarChar(50)
  cssFrameworkMeta Json?   @default("{}") @map("css_framework_meta")
  /**
   * {
   * "confidence": 0.95,
   * "evidence": ["Tailwind CDN detected", "utility classes found: flex, items-center"]
   * }
   */

  // 品質スコア
  qualityScore Json? @map("quality_score")
  /**
   * {
   * "anti_ai_cliche": { "overall": 85, "axes": {...} },
   * "visual_hierarchy": 90,
   * "accessibility": 82
   * }
   */

  // メタデータ
  tags     String[] @default([])
  metadata Json     @default("{}")

  // タイムスタンプ
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // リレーション
  webPage           WebPage            @relation(fields: [webPageId], references: [id], onDelete: Cascade)
  embedding         SectionEmbedding?
  qualityBenchmarks QualityBenchmark[]
  backgroundDesigns BackgroundDesign[]
  componentParts    ComponentPart[]

  @@index([webPageId])
  @@index([sectionType])
  @@index([cssFramework])
  @@index([webPageId, positionIndex])
  @@map("section_patterns")
}

/// SectionEmbedding - セクションパターンのベクトル埋め込み
/// HNSW Indexes (m=16, ef_construction=64, vector_cosine_ops):
///   - idx_section_embeddings_text_hnsw
///   - idx_section_embeddings_vision_hnsw
///   - idx_section_embeddings_combined_hnsw
///   - idx_section_embeddings_mood_hnsw (Phase 5-4)
///   - idx_section_embeddings_brand_tone_hnsw (Phase 5-4)
/// Performance Target: Vector Search P95 < 100ms
model SectionEmbedding {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionPatternId String @unique @map("section_pattern_id") @db.Uuid

  // テキストベースEmbedding（v1, 768D, multilingual-e5-base）
  // HNSW indexed for semantic search
  textEmbedding Unsupported("vector(768)")? @map("text_embedding")

  // ビジョンベースEmbedding（v2予定, 768D）
  // HNSW indexed for semantic search
  visionEmbedding Unsupported("vector(768)")? @map("vision_embedding")

  // Section visual terminal-skip マーカー（ADR-0018 Amendment / PR-BACKFILL-TERMINAL 系統B
  // + PR-C4 PII 非対称 closure）。非NULL値（EMBEDDING_SECTION_VISUAL_SKIP_REASONS =
  // {section_visual_uncroppable, section_visual_duplicate, section_visual_pii_excluded}）は
  // section_visual pending クエリから当該行を除外する（sectionVisualPendingExclusionPredicate、
  // part_visual との対称）。section_visual_pii_excluded は high-PII section の work 側意図的
  // 非生成（GDPR Art.5(1)(c) data-minimisation）の GDPR Art.30 processing trail。CHECK 制約 +
  // partial index は migration 20260524192012（初期2値）+ 20260530…（pii_excluded 追加）で付与。
  //
  // Section visual terminal-skip marker (ADR-0018 Amendment / System B + PR-C4 PII asymmetry
  // closure). A non-NULL value (one of EMBEDDING_SECTION_VISUAL_SKIP_REASONS =
  // {section_visual_uncroppable, section_visual_duplicate, section_visual_pii_excluded}) excludes
  // the row from the section_visual pending query (symmetry with part_visual). section_visual_pii_excluded
  // is the GDPR Art.30 processing trail for the work-side intentional non-generation of high-PII
  // sections (GDPR Art.5(1)(c) data-minimisation). CHECK + partial index are added by migration
  // 20260524192012 (initial 2 values) + 20260530… (adds pii_excluded).
  visionSkipReason String? @map("vision_skip_reason")

  // 統合Embedding（v2予定, 768D）
  // HNSW indexed for semantic search
  combinedEmbedding Unsupported("vector(768)")? @map("combined_embedding")

  // ムードEmbedding（Phase 5-4, 768D, multilingual-e5-base）
  // HNSW indexed for semantic search
  // Vision AI検出のmood情報からEmbedding生成
  moodEmbedding Unsupported("vector(768)")? @map("mood_embedding")

  // ブランドトーンEmbedding（Phase 5-4, 768D, multilingual-e5-base）
  // HNSW indexed for semantic search
  // Vision AI検出のbrandTone情報からEmbedding生成
  brandToneEmbedding Unsupported("vector(768)")? @map("brand_tone_embedding")

  // テキスト表現（Embedding生成元）
  textRepresentation String? @map("text_representation") @db.Text

  // 全文検索用tsvectorカラム（GENERATED ALWAYS AS）
  // PostgreSQL側でtext_representationから自動生成、GINインデックス付き
  searchVector Unsupported("tsvector")? @map("search_vector")

  // ムードテキスト表現（Embedding生成元, Phase 5-4）
  // 例: "primary: professional, secondary: minimal, confidence: 0.75"
  moodTextRepresentation String? @map("mood_text_representation") @db.Text

  // ブランドトーンテキスト表現（Embedding生成元, Phase 5-4）
  // 例: "primary: corporate, secondary: innovative, confidence: 0.80"
  brandToneTextRepresentation String? @map("brand_tone_text_representation") @db.Text

  // Embeddingメタデータ
  // 'e5-base-v1', 'llama-vision-v1', 'e5-base-v1-mood', 'e5-base-v1-brandtone'
  modelVersion       String   @map("model_version")
  embeddingTimestamp DateTime @default(now()) @map("embedding_timestamp") @db.Timestamptz

  // タイムスタンプ
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // リレーション
  sectionPattern SectionPattern @relation(fields: [sectionPatternId], references: [id], onDelete: Cascade)

  @@map("section_embeddings")
}

/// MotionPattern - モーションパターン（scroll_trigger, hover_effect等）
/// category: 'scroll_trigger' | 'hover_effect' | 'page_transition' | 'loading' | etc.
/// triggerType: 'scroll' | 'hover' | 'click' | 'load' | etc.
model MotionPattern {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webPageId String? @map("web_page_id") @db.Uuid // nullableでライブラリ直接登録も可

  // パターン基本情報
  name     String
  // モーションタイプ（css_animation, css_transition, keyframes, library_animation, video_motion）
  type     String?
  // v5.6.0: 新カテゴリ追加 (marquee, video_overlay, parallax, reveal, morphing, background_animation, typing_animation)
  category String // 'scroll_trigger' | 'hover_effect' | 'page_transition' | 'loading_state' | 'micro_interaction' | 'attention_grabber' | 'navigation' | 'feedback' | 'entrance' | 'exit' | 'marquee' | 'video_overlay' | 'parallax' | 'reveal' | 'morphing' | 'background_animation' | 'typing_animation' | 'unknown'

  // トリガー設定
  triggerType   String @map("trigger_type") // 'scroll' | 'hover' | 'click' | 'load'
  triggerConfig Json   @default("{}") @map("trigger_config")

  // アニメーション設定
  animation Json
  /**
   * {
   * "duration": 600,
   * "delay": 0,
   * "easing": { "type": "ease-out" },
   * "iterations": 1,
   * "direction": "normal",
   * "fill_mode": "forwards"
   * }
   */

  // 変化プロパティ
  properties Json @default("[]")
  /**
   * [
   * { "property": "opacity", "from": 0, "to": 1 },
   * { "property": "transform", "from": "translateY(30px)", "to": "translateY(0)" }
   * ]
   */

  // 実装コード
  implementation Json
  /**
   * {
   * "css": "...",
   * "tailwind": "...",
   * "framer_motion": "...",
   * "gsap": "..."
   * }
   */

  // アクセシビリティ
  accessibility Json @default("{}")
  /**
   * {
   * "respects_reduced_motion": true,
   * "alternative_for_reduced": "...",
   * "focus_visible_fallback": "..."
   * }
   */

  // パフォーマンス情報
  performance Json @default("{}")
  /**
   * {
   * "uses_transform": true,
   * "uses_opacity": true,
   * "triggers_layout": false,
   * "triggers_paint": false,
   * "estimated_fps": 60
   * }
   */

  // ソース情報
  sourceUrl  String? @map("source_url") @db.Text
  usageScope String  @default("inspiration_only") @map("usage_scope")

  // メタデータ
  tags     String[] @default([])
  metadata Json     @default("{}")

  // Phase3: 視覚的カテゴリ分類（フレーム差分解析から算出）
  visualCategory   String? @map("visual_category") // 'fade' | 'slide' | 'scale' | 'rotate' | 'parallax' | 'reveal' | 'morph' | 'complex'
  visualConfidence Float?  @map("visual_confidence") // 分類信頼度 (0.0-1.0)
  visualMetrics    Json?   @map("visual_metrics")
  /**
   * {
   * "dominant_direction": "horizontal" | "vertical" | "diagonal" | "radial",
   * "movement_intensity": 0.0-1.0,
   * "change_rate": number,
   * "affected_area_ratio": 0.0-1.0,
   * "frame_diff_stats": {
   * "avg_diff_percentage": number,
   * "max_diff_percentage": number,
   * "motion_consistency": number
   * }
   * }
   */

  // タイムスタンプ
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // リレーション
  webPage   WebPage?         @relation(fields: [webPageId], references: [id], onDelete: SetNull)
  embedding MotionEmbedding?

  @@index([webPageId])
  @@index([category])
  @@index([type])
  @@index([triggerType])
  @@index([visualCategory])
  @@map("motion_patterns")
}

