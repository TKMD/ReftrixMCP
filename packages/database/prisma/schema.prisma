// Reftrix Database Schema
// PostgreSQL 18 + pgvector 0.8
// WebDesign Analysis Platform (MCP-only, no WebUI)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// Publish-only generator: ships generated Prisma client in dist/generated/prisma/
// npm publish 用: 生成済みクライアントを dist/ に同梱して配布
generator publish {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "darwin-arm64", "darwin"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp"), vector, pg_trgm, pgcrypto]
}

