/// QualityEvaluation - 品質評価履歴
/// targetType: 'web_page' | 'section_pattern' | 'generated_code'
/// grade: 'A' | 'B' | 'C' | 'D' | 'F'
/// evaluationMode: 'standard' | 'strict'
model QualityEvaluation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // 評価対象
  targetType String @map("target_type") // 'web_page' | 'section_pattern' | 'generated_code'
  targetId   String @map("target_id") @db.Uuid

  // 評価結果
  overallScore Int    @map("overall_score") // 0-100
  grade        String // 'A' | 'B' | 'C' | 'D' | 'F'

  // anti_ai_cliche詳細
  antiAiCliche Json @map("anti_ai_cliche")
  /**
   * {
   * "overall_score": 75,
   * "axes": {
   * "visual_motifs": { "score": 70, ... },
   * "composition": { "score": 80, ... },
   * "context": { "score": 75, ... }
   * },
   * "patterns_detected": [...],
   * "human_crafted_evidence": [...]
   * }
   */

  // デザイン品質
  designQuality Json? @map("design_quality")

  // 技術品質
  technicalQuality Json? @map("technical_quality")

  // 改善提案
  recommendations String[] @default([])

  // 評価メタデータ
  evaluatorVersion String @map("evaluator_version")
  evaluationMode   String @default("standard") @map("evaluation_mode") // 'standard' | 'strict'

  // 評価時に参照したパターン
  referencedPatterns Json? @map("referenced_patterns")
  /**
   * {
   * "similar_sections": ["uuid1", "uuid2", "uuid3"],
   * "similar_motions": ["uuid4", "uuid5"],
   * "benchmarks_used": ["uuid6", "uuid7"]
   * }
   */

  // パターン類似度スコア
  patternSimilarity Json? @map("pattern_similarity")
  /**
   * {
   * "avg_section_similarity": 0.78,
   * "avg_motion_similarity": 0.82,
   * "closest_benchmark_similarity": 0.91,
   * "highest_quality_match_id": "uuid",
   * "uniqueness_score": 0.65
   * }
   */

  // コンテキスト情報
  evaluationContext Json? @map("evaluation_context")
  /**
   * {
   * "project_id": "uuid",
   * "brand_palette_id": "uuid",
   * "design_system_id": "uuid",
   * "target_industry": "technology",
   * "target_audience": "enterprise"
   * }
   */

  // タイムスタンプ
  evaluatedAt DateTime @default(now()) @map("evaluated_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([targetType, targetId])
  @@index([overallScore])
  @@index([grade])
  @@index([evaluatedAt(sort: Desc)])
  @@map("quality_evaluations")
}

/// QualityBenchmark - 高品質パターンのベンチマーク
/// 品質評価の基準となる高スコアパターン（Overall Score >= 85）を集約
/// HNSW Index: idx_quality_benchmarks_embedding_hnsw (m=16, ef_construction=64, vector_cosine_ops)
model QualityBenchmark {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // 参照元（どちらかがnull可能）
  sectionPatternId String? @map("section_pattern_id") @db.Uuid
  webPageId        String? @map("web_page_id") @db.Uuid

  // ベンチマーク基本情報
  sectionType  String @map("section_type") // hero, feature, cta, etc.
  overallScore Int    @map("overall_score") // 85-100
  grade        String // 'A' | 'B'

  // 特徴量（検索・分類用）
  characteristics String[] @default([])
  // 例: ["gradient-background", "asymmetric-layout", "bold-typography"]

  // ベクトル埋め込み（HNSW indexed, 768D）
  embedding Unsupported("vector(768)")? @map("embedding")

  // 評価詳細（JSON）
  axisScores Json @map("axis_scores")
  /**
   * {
   * "originality": 90,
   * "craftsmanship": 88,
   * "contextuality": 85
   * }
   */

  // コンテキスト情報
  industry String? // healthcare, finance, technology, etc.
  audience String? // enterprise, consumer, professionals

  // ソース情報
  sourceUrl  String @map("source_url") @db.Text
  sourceType String @default("award_gallery") @map("source_type")
  // award_gallery | user_provided | curated

  // HTMLスニペット（参照用）
  htmlSnippet String? @map("html_snippet") @db.Text

  // プレビュー画像URL
  previewUrl String? @map("preview_url") @db.Text

  // タイムスタンプ
  extractedAt DateTime @default(now()) @map("extracted_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // リレーション
  sectionPattern SectionPattern? @relation(fields: [sectionPatternId], references: [id], onDelete: SetNull)
  webPage        WebPage?        @relation(fields: [webPageId], references: [id], onDelete: SetNull)

  @@index([sectionType])
  @@index([overallScore(sort: Desc)])
  @@index([grade])
  @@index([industry])
  @@index([sourceType])
  @@index([extractedAt(sort: Desc)])
  @@map("quality_benchmarks")
}

