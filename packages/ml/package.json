{
  "name": "@reftrixmcp/ml",
  "version": "0.6.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "ML/Embedding services for Reftrix",
  "files": [
    "dist/",
    "src/"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./embeddings": {
      "types": "./dist/embeddings/index.d.ts",
      "default": "./dist/embeddings/index.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "default": "./dist/search/index.js"
    },
    "./dinov2": {
      "types": "./dist/dinov2/index.d.ts",
      "default": "./dist/dinov2/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "download:dinov2": "tsx scripts/download-dinov2.ts",
    "repair:e5-cache": "tsx scripts/repair-e5-cache.ts",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "p-limit": "^3.1.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@reftrixmcp/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TKMD/ReftrixMCP.git",
    "directory": "packages/ml"
  },
  "homepage": "https://github.com/TKMD/ReftrixMCP#readme",
  "bugs": {
    "url": "https://github.com/TKMD/ReftrixMCP/issues"
  }
}
